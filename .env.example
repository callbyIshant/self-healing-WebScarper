# Self-Healing Web Scraper — Environment Configuration
# Copy to .env and fill in your values

# LLM Provider (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Bright Data Scraper Studio & Scraping Browser (Hackathon Integration)
BRIGHT_DATA_API_KEY=your-bright-data-api-key-here
BRIGHT_DATA_SCRAPER_ID=your-custom-scraper-studio-id-here
BRIGHT_DATA_SCRAPING_BROWSER_WS=wss://brd-customer-hl_XXXXXX-zone-scraping_browser:YYYYYY@brd.superproxy.io:9222

# Redis (for distributed rate limiting & ephemeral cache)
REDIS_URL=redis://localhost:6379/0

# Storage paths
SQLITE_DB_PATH=data/scraper.db
COLD_STORAGE_PATH=data/cold_storage
CONFIG_PATH=config

# Telemetry & Observability
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security Hardening
MAX_RESPONSE_SIZE_MB=50
MAX_REDIRECTS=5
PII_REDACTION_ENABLED=true
