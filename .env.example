# Self-Healing Web Scraper — Environment Configuration
# Copy to .env and fill in your values

# LLM Provider
GEMINI_API_KEY=your-gemini-api-key-here

# Redis (for rate limiting and ephemeral cache)
REDIS_URL=redis://localhost:6379/0

# Storage paths
SQLITE_DB_PATH=data/scraper.db
COLD_STORAGE_PATH=data/cold_storage
CONFIG_PATH=config

# Telemetry
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
MAX_RESPONSE_SIZE_MB=50
MAX_REDIRECTS=5
PII_REDACTION_ENABLED=true
